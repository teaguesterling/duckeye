#!/usr/bin/env bash
# duckeye — pretty-print a document in the terminal via DuckDB duck_blocks.
#
# Usage: duckeye [OPTION]... FILE
#
# Dispatches on extension to whichever duck_blocks producer can read the format,
# then renders with `PRAGMA duck_block_render`.
#
# Env:
#   DUCKEYE_BASE       extensions always loaded   (default: duck_block_utils)
#   DUCKEYE_EXTS       extra extensions to LOAD   (space-separated)
#   DUCKEYE_PAGER      pager used by -p           (default: less -R)
#   DUCKEYE_OFFICIAL   --init installs these from the core repo
#   DUCKEYE_COMMUNITY  --init installs these from the community repo
set -uo pipefail

: "${DUCKEYE_BASE:=duck_block_utils}"
: "${DUCKEYE_EXTS:=}"
: "${DUCKEYE_PAGER=less -R}"

# --init only. Separate from the LOAD lists above because installing needs to
# know which repository each extension comes from; LOAD does not.
: "${DUCKEYE_OFFICIAL:=http aws excel}"
: "${DUCKEYE_COMMUNITY:=duck_block_utils markdown webbed zim pdf yaml toml read_lines duck_tails zipfs textplot sitting_duck}"

usage() {
  cat <<'EOF'
usage: duckeye [OPTION]... [FILE]

Pretty-print a document in the terminal via DuckDB duck_blocks.

FILE of "-", or no FILE at all when something is piped in, reads standard
input. Piped input is sniffed for its format; -f overrides the guess.

Options:
  -p, --page             page the output through $DUCKEYE_PAGER (default: less -R)
  -P, --pages RANGE      page or page range for PDFs (e.g. 3, 1-5, 1..5, -10, 5-)
  -T, --toc              print the table of contents, one heading per line,
                         indented by level (feeds straight into -S)
  -S, --section NAME     print only the section whose heading matches NAME,
                         through to the next heading of the same or higher
                         level (so a chapter carries its subsections)
  -s, --search TEXT      print only the innermost sections whose text contains
                         TEXT, headings and code blocks included
  -Q, --select SEL       query by CSS selector. Code: .func, .class#Name,
                         .func:async. Documents: heading, li, h2, code[language=sh],
                         list > list_item -- HTML type names are accepted as aliases
  -d, --data             read FILE as data, not prose: SELECT * FROM FILE
                         (parquet, csv, json, xlsx, ...). Piped, it emits JSONL
  -D, --document         undo an earlier -d and read FILE as prose. Data files
                         (parquet, csv, ...) still route to data: use -f to name
                         a document reader if sniffing picks the wrong one
  -z, --summary          summarize data columns via DuckDB SUMMARIZE; implies -d
  -Z, --profile          smart column profile with sparklines & category frequencies
  -i, --input FILE       the input file; the same as giving FILE positionally.
                         Giving both is an error
  -o, --output FILE      write to FILE instead of stdout (escapes are stripped).
                         NOTE: -o names a FILE, not a format -- use -t for that
  -t, --to FMT           write the document as ansi (default), text, md, html,
                         pandoc (a Pandoc AST) or blocks (duck_blocks JSON).
                         Applies after -S/-s, so a section converts on its own.
                         Not for -d, -z, -Z, -T, or an archive's corpus listings
  -f, --from FMT         treat the input as FMT rather than guessing from the
                         filename: md, html, pdf, rst, docx, tex, zim, ...
                         Under -d, FMT names a DuckDB reader: csv, parquet, json, pdf, yaml, ...
  -w, --where EXPR       SQL WHERE clause for data modes (-d, -z, -Z); implies -d
  -n, --limit N          cap the rows any listing prints (-d, -z, -Z, and .zim -T/-s)
      --color WHEN       auto (default), always, never. auto means colour when
                         stdout is a terminal, or when -p is paging through
                         less -R. $NO_COLOR disables it
      --init             install the DuckDB extensions duckeye needs, then exit
      --update           update DuckDB extensions and duckeye, then exit
  -h, --help             show this help

NAME and TEXT match case-insensitively as substrings; SQL LIKE wildcards
(% and _) work. -S also matches a heading's slug id exactly. -t, -S, -s, -r, -z
and -Z are mutually exclusive. -S and -s exit 1 when nothing matches.

Formats:
  .md .markdown        markdown extension
  .htm .html           webbed extension
  .pdf                 pdf extension (via pdf_to_markdown or read_pdf)
  .json                Pandoc AST
  .docx .odt .epub .org .tex .rtf .textile .mediawiki
                       panduck extension, natively (no pandoc(1) needed)
  .rst .ipynb          via pandoc(1) — panduck reads both, but loses table-cell
                       markup (.rst) and notebook cell structure (.ipynb)
  .man .1 ... .9       man page source, via pandoc(1) — roff has no native reader
  .zim  zim://...      zim extension (see ZIM archives below)
  -d bypasses this table entirely and hands FILE to DuckDB, so the format is
  whatever DuckDB's replacement scan makes of the extension. Under -d a .json
  file is data rather than a Pandoc AST. LOAD anything extra via DUCKEYE_EXTS.
  -r is a deprecated alias for -d and warns.

Raw mode prints through DuckDB's own box renderer rather than duck_blocks: it
streams (a million rows in about a second, where the ANSI block renderer stalls
past twenty thousand) and emits plain UTF-8, so it pipes into grep and awk.

ZIM archives (Kiwix / openZIM: offline Wikipedia, Gutenberg, Stack Exchange):

  duckeye wiki.zim                  # what this archive holds
  duckeye -t wiki.zim               # index it (path, title)
  duckeye -s photosynthesis wiki.zim    # the archive's own full-text search,
                                        # ranked, with snippets
  duckeye -S Photosynthesis wiki.zim    # open that article
  duckeye -s stoma 'zim://wiki.zim/Photosynthesis'   # search inside one article

An archive is a corpus, so -t, -s and -S address articles: -s is the archive's
Xapian index, not a substring scan, and -S resolves a title through the title
index. A zim:// URL names one article and behaves like any other HTML document,
so the ordinary section verbs apply to it unchanged. Both stay sub-second on a
full English Wikipedia.

Env:
  DUCKEYE_BASE       extensions always loaded  (default: duck_block_utils)
  DUCKEYE_EXTS       extra extensions to LOAD  (space-separated)
  DUCKEYE_PAGER      pager used by -p          (default: less -R)
  DUCKEYE_OFFICIAL   --init installs these from the core repo
  DUCKEYE_COMMUNITY  --init installs these from the community repo
                     (default: duck_block_utils markdown webbed zim pdf yaml
                      toml read_lines duck_tails zipfs textplot sitting_duck)

Examples:
  duckeye README.md                  # render to stdout, unpaged
  dep README.md                      # same, paged (alias for duckeye -p)
  duckeye -t spec.md                 # outline
  duckeye -S 'Runbook Steps' spec.md # one section
  duckeye -s tmux spec.md            # every section mentioning tmux
EOF
}

die() { printf 'duckeye: %s\n' "$1" >&2; exit "${2:-1}"; }

# Each extension is named alongside the repository it comes from, so a failure
# reports DuckDB's own reason instead of being masked by a guess at the other repo.
init() {
  local e repo rc=0 err
  for repo in core community; do
    for e in $( [[ $repo == core ]] && echo "$DUCKEYE_OFFICIAL" || echo "$DUCKEYE_COMMUNITY" ); do
      printf '%-20s %-10s ' "$e" "$repo"
      if err=$(duckdb -s "INSTALL $e FROM $repo;" 2>&1); then
        echo installed
      else
        echo FAILED; printf '%s\n' "$err" | sed 's/^/    /' >&2; rc=1
      fi
    done
  done
  printf '%-20s %-10s ' pandoc system
  if command -v pandoc >/dev/null; then echo found
  else echo 'missing — .rst/.ipynb/.man will not render; the rest use panduck'
  fi
  return $rc
}

update() {
  local rc=0
  printf 'updating duckdb extensions...\n'
  duckdb -dark-mode -c "UPDATE EXTENSIONS;" 2>&1 || true
  init || rc=1

  local bin_path script_dir repo_root
  bin_path=$(readlink -f "$0" 2>/dev/null || echo "$0")
  script_dir=$(dirname "$bin_path")

  if git -C "$script_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    repo_root=$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)
    if [[ -n $repo_root && -f "$repo_root/install.sh" ]]; then
      printf 'updating duckeye repository via git...\n'
      if git -C "$repo_root" pull --ff-only 2>&1; then
        printf 're-running installer...\n'
        "$repo_root/install.sh" --no-init || rc=1
      else
        printf 'warning: git pull failed; check git repository status\n' >&2
      fi
    fi
  else
    printf 'updating standalone duckeye from github...\n'
    local tmp_update
    tmp_update=$(mktemp -d)
    if curl -fsSL "https://raw.githubusercontent.com/teaguesterling/duckeye/main/duckeye" -o "$tmp_update/duckeye" 2>/dev/null; then
      chmod +x "$tmp_update/duckeye"
      if cp "$tmp_update/duckeye" "$bin_path" 2>/dev/null; then
        printf 'duckeye binary updated at %s\n' "$bin_path"
      else
        printf 'warning: cannot overwrite %s (permission denied)\n' "$bin_path" >&2
        rc=1
      fi
      if curl -fsSL "https://raw.githubusercontent.com/teaguesterling/duckeye/main/install.sh" -o "$tmp_update/install.sh" 2>/dev/null; then
        chmod +x "$tmp_update/install.sh"
        "$tmp_update/install.sh" --no-init --user-bin 2>/dev/null || true
      fi
    else
      printf 'warning: failed to download latest duckeye from github\n' >&2
      rc=1
    fi
    rm -rf "$tmp_update"
  fi
  return $rc
}

# SQL single-quoted literal: double the quotes.
q() { printf '%s' "${1//\'/\'\'}"; }

# Aliases: dep auto-pages on tty; der defaults to raw data mode
[[ $(basename "$0") == dep && -t 1 ]] && do_page=1 || do_page=
[[ $(basename "$0") == der ]] && mode=raw || mode=full
arg= where= limit= fmt= color=auto out_fmt=ansi pages=
in_file= out_file=

# Wrap an expression yielding LIST(duck_block) in whichever serializer -t asked for.
# These are the duck_blocks pipeline's own writers, which is the whole point: they run
# after -S/-s have already cut the document down, so a section can come out as markdown.
emit() {
  case $out_fmt in
    ansi)      printf 'duck_blocks_render_ansi(%s)' "$1" ;;
    text)      printf 'duck_blocks_to_text(%s)' "$1" ;;
    html)      printf 'duck_blocks_to_html(%s)' "$1" ;;
    blocks)    printf 'to_json(%s)' "$1" ;;
    md)        printf 'duck_blocks_to_md(%s)' "$1" ;;
    pandoc)    printf 'db_to_pandoc_json(%s)' "$1" ;;
    *)         die "unknown output format: $out_fmt (ansi, text, md, html, pandoc, blocks)" 64 ;;
  esac
}

# Colour when a terminal will see the escapes: stdout is a tty, or -p is about to hand
# the output to less -R, which reads them. Honours the NO_COLOR convention.
want_color() {
  case $color in
    always) return 0 ;;
    never)  return 1 ;;
    auto)   ;;
    *)      die "--color takes auto, always or never, got '$color'" 64 ;;
  esac
  [[ -n ${NO_COLOR:-} ]] && return 1
  [[ -n $do_page ]] && return 0
  [[ -t 1 ]]
}

# Determine dark vs light mode for DuckDB's box renderer.
# Checks $DUCKEYE_THEME, $COLORFGBG, and runs a 50ms OSC 11 probe on interactive ttys
# to avoid DuckDB's 5-second blocking background-color timeout in non-interactive shells.
duckdb_color_mode() {
  if [[ -n ${DUCKEYE_THEME:-} ]]; then
    case "${DUCKEYE_THEME,,}" in
      light) echo "-light-mode"; return ;;
      dark)  echo "-dark-mode"; return ;;
    esac
  fi

  if [[ -n ${COLORFGBG:-} ]]; then
    local bg="${COLORFGBG##*;}"
    if [[ $bg =~ ^[0-9]+$ ]]; then
      if (( bg == 7 || bg == 15 )); then
        echo "-light-mode"; return
      else
        echo "-dark-mode"; return
      fi
    fi
  fi

  if [[ -t 0 && -t 1 && -n ${TERM:-} && $TERM != "dumb" ]]; then
    local resp
    printf '\e]11;?\e\\' >/dev/tty 2>/dev/null
    if read -t 0.05 -rs -d '\' resp </dev/tty 2>/dev/null; then
      if [[ $resp =~ rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+) ]]; then
        local r="0x${BASH_REMATCH[1]:0:2}"
        local g="0x${BASH_REMATCH[2]:0:2}"
        local b="0x${BASH_REMATCH[3]:0:2}"
        local lum=$(( (299 * r + 587 * g + 114 * b) / 1000 ))
        if (( lum > 128 )); then
          echo "-light-mode"; return
        else
          echo "-dark-mode"; return
        fi
      fi
    fi
  fi

  echo "-dark-mode"
}

setmode() { [[ $mode == full || $mode == "$1" ]] || die 'use only one of -T, -S, -s, -d, -z, -Z' 64; mode=$1; }

# duck_blocks_to_pandoc_ast stamps pandoc-api-version [1,20], which pandoc 3.x refuses
# outright (teaguesterling/duckdb_duck_block_utils#22). The encoding itself is fine, so
# ask the local pandoc what version it speaks and stamp that instead.

# Guess a format from the first bytes, for stdin with no -f. Only claims what it can
# actually tell apart; anything else falls through to markdown, which is the format
# most likely to be piped around and degrades into readable plain text regardless.
sniff() {
  # Magic bytes first, read as hex so a binary file cannot trip the shell's
  # null-byte warning on command substitution.
  local magic; magic=$(od -An -tx1 -N4 <"$1" 2>/dev/null | tr -d ' \n')
  case $magic in
    25504446*) echo pdf; return ;;             # %PDF
    504b0304*) sniff_zip "$1"; return ;;       # PK\x03\x04 — docx/epub/odt
  esac
  local h; h=$(head -c 1024 "$1" 2>/dev/null | tr -d '\0')
  case $h in
    '<!DOCTYPE html'*|'<!doctype html'*) echo html; return ;;
    '<!DOCTYPE HTML'*|'<html'*|'<HTML'*) echo html; return ;;
  esac
  case $h in
    '#!'*python*)                        echo py;         return ;;
    '#!'*bash*|'#!'*sh*|'#!'*zsh*)       echo sh;         return ;;
    '#!'*ruby*)                          echo rb;         return ;;
    '#!'*node*)                          echo js;         return ;;
    *'"pandoc-api-version"'*)            echo pandoc_ast; return ;;   # a Pandoc AST
    '.TH '*|'.\"'*|"'\\\""*|'.SH '*)     echo man;        return ;;   # roff
    '<?xml'*|'<'*)                       echo html;       return ;;
  esac
  echo md
}

# docx/epub/odt are all zip containers; their manifests tell them apart.
sniff_zip() {
  command -v unzip >/dev/null || { echo zip; return; }
  local names; names=$(unzip -Z1 "$1" 2>/dev/null)
  case $names in
    *word/document.xml*) echo docx ;;
    *mimetype*epub*|*OEBPS*|*META-INF/container.xml*) echo epub ;;
    *content.xml*)       echo odt ;;
    *)                   echo zip ;;
  esac
}

while (( $# )); do
  case $1 in
    -p|--page)     do_page=1 ;;
    -P|--pages)    [[ $# -ge 2 ]] || die '-P/--pages needs a page or range (e.g. 3, 1-5, 1..5)' 64
                   pages=$2; shift ;;
    --pages=*)     pages=${1#--pages=} ;;
    -h|--help)     usage; exit 0 ;;
    --init)        init; exit $? ;;
    --update)      update; exit $? ;;
    -T|--toc)      setmode toc ;;
    # -r is a deprecated alias for -d. Its old spelling is unambiguous, so failing it
    # would cost users for no safety gain -- unlike -o, whose old spelling stays valid
    # under the new meaning and silently writes a file.
    -r|--raw)      printf 'duckeye: -r is deprecated; use -d (interpret as data)\n' >&2
                   setmode raw ;;
    -d|--data)     setmode raw ;;
    # -D resets to document interpretation, so `-d -D` is a document. Without this
    # it would parse and do nothing, since document is already the default -- a flag
    # that is accepted and inert is worse than an unknown-option error.
    -D|--document) mode=full ;;
    -z|--summary|--summarize) setmode summary ;;
    -Z|--profile|--smart-summary) setmode profile ;;
    -S|--section)  [[ $# -ge 2 ]] || die '-S needs a section name' 64; setmode section; arg=$2; shift ;;
    -s|--search)   [[ $# -ge 2 ]] || die '-s needs search text' 64; setmode search; arg=$2; shift ;;
    -Q|--select)   [[ $# -ge 2 ]] || die '-Q/--select needs a CSS selector' 64; selector=$2; shift ;;
    --select=*)    selector=${1#--select=} ;;
    -f|--from|--format) [[ $# -ge 2 ]] || die '-f needs an input format' 64; fmt=${2,,}; shift ;;
    -t|--to)       [[ $# -ge 2 ]] || die '-t needs an output format' 64; out_fmt=${2,,}; shift ;;
    -i|--input)    [[ $# -ge 2 ]] || die '-i needs a FILE' 64; in_file=$2; shift ;;
    # -o is the output FILE, per pandoc, gcc, curl and ld. Under duckeye's previous
    # meaning it named a FORMAT, and that spelling stays syntactically valid here --
    # `-o html doc.md` would quietly create a file called "html". Refusing a
    # format-shaped value converts the worst migration break into a teaching error;
    # ./html escapes the guard for anyone who genuinely means it.
    -o|--output)   [[ $# -ge 2 ]] || die '-o needs an output FILE' 64
                   case ${2,,} in
                     ansi|text|md|markdown|html|pandoc|blocks|box|csv|tsv|tabs|json|jsonl|jsonlines|latex|line|list|ascii|column|insert|quote|duckbox)
                       die "-o now names an output FILE, not a format; did you mean -t $2 ?" 64 ;;
                   esac
                   out_file=$2; shift ;;
    --color)       [[ $# -ge 2 ]] || die '--color needs auto, always or never' 64
                   color=${2,,}; shift ;;
    --color=*)     color=${1#--color=}; color=${color,,} ;;
    -w|--where)    [[ $# -ge 2 ]] || die '-w needs a WHERE expression' 64
                   [[ $mode == full ]] && setmode raw
                   where=$2; shift ;;
    -n|--limit)    [[ $# -ge 2 ]] || die '-n needs a row count' 64
                   [[ $2 =~ ^[0-9]+$ ]] || die "-n needs a non-negative integer, got '$2'" 64
                   limit=$2; shift ;;
    --)            shift; break ;;
    -)             break ;;                      # the conventional name for stdin
    -*)            die "unknown option: $1" 64 ;;
    *)             break ;;
  esac
  shift
done

p_first= p_last=
if [[ -n $pages ]]; then
  if [[ $pages =~ ^([0-9]+)-([0-9]+)$ || $pages =~ ^([0-9]+)\.\.([0-9]+)$ ]]; then
    p_first=${BASH_REMATCH[1]} p_last=${BASH_REMATCH[2]}
  elif [[ $pages =~ ^([0-9]+)-$ ]]; then
    p_first=${BASH_REMATCH[1]}
  elif [[ $pages =~ ^-([0-9]+)$ ]]; then
    p_first=1 p_last=${BASH_REMATCH[1]}
  elif [[ $pages =~ ^([0-9]+)$ ]]; then
    p_first=${BASH_REMATCH[1]} p_last=${BASH_REMATCH[1]}
  else
    die "invalid page range: '$pages' (expected N, N-M, N..M, N-, or -M)" 64
  fi
fi

if [[ $out_fmt != ansi ]]; then
  emit x >/dev/null                       # reject an unknown format before doing work
  [[ $mode == raw || $mode == summary || $mode == profile ]] && die '-t does not apply to data modes: output is a data table' 64
  [[ $mode == toc ]] && die '-t does not apply to -T: the outline is already plain text' 64
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/duckeye.XXXXXX") || die 'cannot create temp directory'
trap 'rm -rf "$tmp"' EXIT

# Three ways in -- positional, -i, and stdin -- so the precedence is stated rather
# than left to whichever branch runs first. Giving both is an error, not a silent
# preference for one of them.
if [[ -n $in_file ]]; then
  (( $# )) && die 'give either -i FILE or a positional FILE, not both' 64
  set -- "$in_file"
fi
f=${1:-}
# Parsing stops at the first non-flag, so anything after FILE lands here as a second
# FILE. Saying "only one FILE" about `-t text` is false and reads as a glob problem.
# Measured: `-S Setup doc.md -t text` reported two files while the identical command
# with -t before doc.md worked, which looked like -S not supporting what -Q supports.
if [[ $# -gt 1 ]]; then
  for extra in "${@:2}"; do
    [[ $extra == -* ]] &&
      die "flags must come before FILE (saw $extra after $1)" 64
  done
  die 'only one FILE at a time' 64
fi

# Standard input: an explicit "-", or no FILE at all with something piped in. It is
# spooled to a file rather than streamed because pandoc needs to seek (a .docx is a zip),
# because the section and search queries read the document more than once, and because
# sniffing has to look at the first bytes without consuming them.
if [[ $f == - || ( -z $f && ! -t 0 ) ]]; then
  f=$tmp/stdin from_stdin=1
  cat >"$f" || die 'cannot read standard input'
  [[ -s $f ]] || die 'standard input was empty'
  if [[ -z $fmt ]]; then
    # Sniffing recognises document formats. Under -d the input is data, where the
    # candidates are indistinguishable often enough that guessing would be a liability.
    [[ $mode == raw ]] &&
      die 'reading data from standard input needs -f (csv, parquet, json, ...)' 64
    fmt=$(sniff "$f")
    case $fmt in
      zip) die 'standard input is a zip container of an unknown kind; name it with -f' 2 ;;
    esac
  fi
fi

[[ -n $f ]] || { usage >&2; exit 64; }
# Allow HTTP, HTTPS, S3, git URLs, and glob patterns (* or ?)
if [[ $f == zim://* || $f == git://* || -r $f || $f == http*://* || $f == https*://* || $f == s3*://* || $f == *\** || $f == *\?* ]]; then
    :
else
    die "cannot read $f"   # zim:// resolves inside the archive
fi

# Dispatch on -f when given, otherwise on the filename. Synthesising an extension lets
# one table below serve both, so a format name is exactly the extension that implies it.
# Normalise into a synthetic extension for the document table only. $fmt itself stays
# as typed, because raw mode reads it as a DuckDB reader name where txt means csv, not
# markdown.
norm=$fmt
case $norm in
  latex)          norm=tex ;;
  markdown)       norm=md ;;
  htm)            norm=html ;;
  text|txt|plain) norm=md ;;    # plain text is legible markdown
  python)         norm=py ;;
  bash|shell|zsh) norm=sh ;;
  javascript)     norm=js ;;
  typescript)     norm=ts ;;
  rust)           norm=rs ;;
  golang)         norm=go ;;
  ruby)           norm=rb ;;
  c++)            norm=cpp ;;
  pandoc|pandoc_ast) norm=pandoc_ast ;;
  ast|code)
    if [[ -f $f ]]; then
      sniffed=$(sniff "$f")
      case $sniffed in
        py|sh|rb|js) norm=$sniffed ;;
        pandoc_ast)  norm=pandoc_ast ;;
        *)           norm=auto ;;
      esac
    else
      norm=auto
    fi ;;
esac

# If no format specified and filename has no extension, sniff it (e.g. executable scripts)
if [[ $f != *\** && $f != *\?* ]]; then
  base=$(basename "${f%@*}")
  if [[ -z $norm && $base != *.* && -f $f && $f != zim://* && $f != git://* ]]; then
    sniffed=$(sniff "$f")
    case $sniffed in
      py|sh|rb|js) norm=$sniffed ;;
      pandoc_ast)  norm=pandoc_ast ;;
    esac
  fi
fi

f_no_ref="${f%@*}"
key=${f_no_ref,,}
[[ -n $norm ]] && key=".$norm"

# Sniff json to distinguish Pandoc AST from structured data
is_pandoc_json() {
  local target=$1
  [[ -f $target || -n ${from_stdin:-} ]] && grep -q '"pandoc-api-version"' <(head -c 4096 "$target" 2>/dev/null)
}

is_data_file() {
  case "$fmt" in
    csv|tsv|parquet|pq|ndjson|jsonl|yaml|yml|toml|excel|xlsx|xls|zip|git|lines)
      return 0 ;;
    json)
      is_pandoc_json "$f" && return 1 || return 0 ;;
    pandoc|pandoc_ast)
      return 1 ;;
  esac
  case "$key" in
    *.parquet|*.pq|*.csv|*.tsv|*.tab|*.ndjson|*.jsonl|*.yaml|*.yml|*.toml|*.xlsx|*.xls|*.git|*/.git|.git)
      return 0 ;;
    *.zip)
      if [[ -f $f ]]; then
        [[ $(sniff_zip "$f") == zip ]] && return 0
      else
        return 0
      fi
      return 1 ;;
    *.json)
      is_pandoc_json "$f" && return 1 || return 0 ;;
  esac
  return 1
}

# Data files default to raw table mode
if [[ $mode == full ]] && is_data_file; then
  mode=raw
fi

# Some producers check the filename, not just the bytes — read_markdown_blocks and
# sitting_duck reject anything without the expected extension. Rename spooled stdin
# or create a temporary symlink so DuckDB's scanners accept the file.
if [[ -n $norm && $norm != auto && $f != *\** && $f != *\?* && $f != zim://* && ( -f $f || -n ${from_stdin:-} ) ]]; then
  base=$(basename "$f")
  if [[ $base != *.$norm ]]; then
    if [[ -n ${from_stdin:-} ]]; then
      mv "$f" "$f.$norm" && f=$f.$norm
    else
      target_path=$(readlink -f "$f" 2>/dev/null || realpath "$f" 2>/dev/null || echo "$PWD/$f")
      link_name="$tmp/$base.$norm"
      ln -sf "$target_path" "$link_name" && f=$link_name
    fi
  fi
fi

src=$(q "$f")
pat_sql="${arg//\\/\\\\}"
pat_sql="${pat_sql//%/\\%}"
pat_sql="${pat_sql//_/\\_}"
pat_sql="${pat_sql//\*/%}"
pat_sql="${pat_sql//\?/_}"
pat=$(q "$pat_sql")
exts= doc= via_pandoc= zim_open= premacro=

# A ZIM entry is whatever its mimetype says, not always HTML: a Gutenberg archive is
# mostly images, and even a Wikipedia carries CSS and JS. Dispatching on zim_mimetype
# keeps a stylesheet from being parsed as a page.
#
# Each branch's ARGUMENT is guarded by the same mimetype test as its WHEN, not just
# the branch. DuckDB evaluates the arms of a CASE eagerly, so an unguarded
# zim_get_content() fed poppler the bytes of every HTML article -- "May not be a PDF
# file", then hex-string errors spelling out "<!DOCTYPE html" -- and an unguarded
# zim_get_text() handed parse_html_blocks() a NULL for every binary entry, which it
# cannot bind. The guards make the non-matching arms cheap and well-typed instead.
# A macro rather than SQL inlined at
# every call site, and a macro rather than an extension function because it spans two
# extensions that deliberately do not depend on each other.
zim_macro="CREATE OR REPLACE TEMP MACRO zim_to_blocks(archive, entry) AS (
  CASE
    WHEN zim_mimetype(archive, entry) LIKE 'text/html%'
      -- html_to_duck_blocks is the SCALAR reader, deliberately. parse_html_blocks
      -- is a TABLE function and accepts only literal arguments, so it cannot be
      -- used here: -S on an archive calls this macro with a COLUMN (the path from
      -- zim_suggest) and DuckDB rejects it outright --
      --   does not support lateral join column parameters
      -- which broke opening an article by title entirely from be3ef5d until now.
      THEN html_to_duck_blocks(zim_get_text(archive, entry))
    WHEN zim_mimetype(archive, entry) LIKE 'text/markdown%'
      THEN parse_markdown_to_duck_blocks(zim_get_text(archive, entry))
    WHEN zim_mimetype(archive, entry) LIKE 'application/pdf%'
      THEN parse_markdown_to_duck_blocks(pdf_to_text(
             CASE WHEN zim_mimetype(archive, entry) LIKE 'application/pdf%'
                  THEN zim_get_content(archive, entry) END))
    WHEN zim_mimetype(archive, entry) LIKE 'text/%'
      THEN duck_block_code(zim_get_text(archive, entry))
    -- A missing entry and an unrenderable one are different answers. zim_mimetype
    -- returns NULL for an entry the archive does not hold, which used to coalesce
    -- to 'unknown type' and print '(no renderer for unknown type: NAME)' on stdout
    -- with exit 0 -- plausible text and success for a document that is not there.
    -- Worst shape for anything piping duckeye. error() raises, so the exit code
    -- says so; it stays lazy in a non-taken CASE arm, unlike the readers above.
    ELSE CASE WHEN zim_mimetype(archive, entry) IS NULL
           THEN error('zim entry not found: ' || entry)
           ELSE duck_block_paragraph('(no renderer for '
                                     || zim_mimetype(archive, entry)
                                     || ': ' || entry || ')')
         END
  END);"

# Sparklines come from textplot's tp_sparkline(), which returns a fixed 20 columns
# regardless of bin count.
#
# Loading textplot used to SIGSEGV -Z on roughly 1-in-5 runs. The cause is not
# textplot's plotting code -- the profiling SQL calls no tp_* function at all --
# but an autoloaded httpfs whose OpenSSL shutdown collides with it at process
# exit (Query-farm/textplot#4). Disabling autoload for local sources, done where
# the load string is built below, takes it to 0-in-25. The pure-SQL encoder below
# is kept as the drop-in if that ever stops holding.
#
# Pure-SQL Unicode sparkline (10 bins -> 10 columns), the crash-free alternative:
# Encodes list of counts across 10 bins into 8-level Unicode sparkline blocks (' ', '▂'..'█', U+2581-U+2588):
# CREATE OR REPLACE TEMP MACRO sql_sparkline(bin_counts) AS (
#   SELECT string_agg(CASE WHEN cnt = 0 THEN ' ' ELSE chr(9601 + least(7, floor(7.999 * cnt / NULLIF(list_max(bin_counts), 0))::INT)) END, '')
#   FROM unnest(bin_counts) t(cnt)
# );

# Data modes (raw, summary, profile) operate directly on tables/scans without duck_block_utils:
# DuckDB's own box renderer streams and emits clean tabular output.
if [[ $mode == raw || $mode == summary || $mode == profile ]]; then
  # Bare '<path>' leans on DuckDB's replacement scan, which reads the extension — so a
  # spooled stdin, having none, needs the reader named. That is what -f supplies here.
  case $fmt in
    '')
      if [[ $key == *.pdf ]]; then
        from="read_pdf('$src')"
        exts="pdf"
      elif [[ $key == *.yaml || $key == *.yml ]]; then
        from="read_yaml('$src')"
        exts="yaml"
      elif [[ $key == *.toml ]]; then
        from="(SELECT parse_toml(content) AS toml FROM read_text('$src'))"
        exts="toml"
      elif [[ $key == *.xlsx || $key == *.xls ]]; then
        from="read_xlsx('$src')"
        exts="excel"
      elif [[ $key == *.zip ]]; then
        from="zip_contents('$src')"
        exts="zipfs"
      elif [[ $key == *.json || $key == *.ndjson || $key == *.jsonl ]]; then
        from="read_json('$src')"
      elif [[ $key == *.git || $key == */.git || $key == .git ]]; then
        local_repo=${src%/.git}
        local_repo=${local_repo%.git}
        from="git_log('${local_repo:-.}')"
        exts="duck_tails"
      elif [[ $key == *.py || $key == *.pyi || $key == *.pyw || $key == *.rs || \
              $key == *.go || $key == *.c || $key == *.h || $key == *.cpp || \
              $key == *.hpp || $key == *.cc || $key == *.cxx || $key == *.c++ || \
              $key == *.hh || $key == *.hxx || $key == *.js || $key == *.jsx || \
              $key == *.mjs || $key == *.cjs || $key == *.ts || $key == *.tsx || \
              $key == *.java || $key == *.kt || $key == *.kts || $key == *.cs || \
              $key == *.swift || $key == *.rb || $key == *.ruby || $key == *.php || \
              $key == *.lua || $key == *.r || $key == *.sh || $key == *.bash || \
              $key == *.zsh || $key == *.zig || $key == *.dart || $key == *.sql || \
              $key == *.gql || $key == *.graphql || $key == *.tf || $key == *.hcl || \
              $key == *.css ]]; then
        if [[ -n ${selector:-} ]]; then
          from="ast_select('$src', '$(q "$selector")')"
        else
          from="read_ast('$src', peek := 'full')"
        fi
        exts="sitting_duck"
      else
        if [[ $f == git://* ]]; then
          if [[ $key == *.parquet || $key == *.pq ]]; then
            from="read_parquet('$src')"
          elif [[ $key == *.csv || $key == *.tsv ]]; then
            from="read_csv('$src')"
          else
            from="read_text('$src')"
          fi
        else
          from="'$src'"
        fi
      fi ;;
    csv|tsv|txt|text)  from="read_csv('$src')" ;;
    parquet|pq)        from="read_parquet('$src')" ;;
    json|ndjson|jsonl) from="read_json('$src')" ;;
    pdf)               from="read_pdf('$src')"; exts="pdf" ;;
    yaml|yml)          from="read_yaml('$src')"; exts="yaml" ;;
    toml)              from="(SELECT parse_toml(content) AS toml FROM read_text('$src'))"; exts="toml" ;;
    excel|xlsx|xls)    from="read_xlsx('$src')"; exts="excel" ;;
    zip)               from="zip_contents('$src')"; exts="zipfs" ;;
    git)               local_repo=${src%/.git}; local_repo=${local_repo%.git}
                       from="git_log('${local_repo:-.}')"; exts="duck_tails" ;;
    lines)             from="read_lines('$src')"; exts="read_lines" ;;
    ast|code)          if [[ -n ${selector:-} ]]; then
                         from="ast_select('$src', '$(q "$selector")')"
                       else
                         from="read_ast('$src', peek := 'full')"
                       fi
                       exts="sitting_duck" ;;
    *)                 die "unknown format for -d: $fmt" ;;
  esac

  if [[ $f == git://* ]]; then
    exts="$exts duck_tails"
  fi

  # DuckDB's .mode jsonlines prints an EXTENSION-DEFINED type's label UNQUOTED at the
  # top level -- {"semantic_type":DEFINITION_MODULE} -- which is not valid JSON. The same
  # type nested inside a STRUCT/LIST is emitted numerically and is fine, and a plain
  # inline ENUM is quoted correctly, so this is narrow: it bites only sitting_duck's
  # SEMANTIC_TYPE, and only as a bare column. Casting it to VARCHAR keeps the LABEL
  # (to_json() would give 252 instead) and costs nothing. Measured: without this,
  # `duckeye -d <source file>` piped emitted 6425 of 6425 invalid lines.
  #
  # This is DuckDB's bug, not sitting_duck's and not ours; the cast is a workaround and
  # should be deleted once .mode jsonlines quotes custom-type labels.
  ast_safe=
  [[ $from == read_ast\(* || $from == ast_select\(* ]] &&
    ast_safe=" REPLACE (semantic_type::VARCHAR AS semantic_type)"
  target_query="SELECT *${ast_safe} FROM $from"
  [[ -n $where ]] && target_query+=" WHERE $where"
  [[ -n $limit ]] && target_query+=" LIMIT $limit"

  term_cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 120)}
  [[ $term_cols =~ ^[0-9]+$ && $term_cols -gt 0 ]] || term_cols=120

  if [[ $mode == summary ]]; then
    sql="SUMMARIZE ($target_query);"
  elif [[ $mode == profile ]]; then
    load=
    for e in $exts $DUCKEYE_EXTS; do load+="LOAD $e; "; done
    cols_raw=$(duckdb -dark-mode -noheader -list -s "$load" -s "CREATE VIEW __duckeye_src AS $target_query; SELECT column_name || chr(9) || column_type FROM (DESCRIBE __duckeye_src);" 2>/dev/null) || die "failed to inspect columns for profiling" 1

    if [[ $term_cols -le 85 ]]; then
      summary_budget=$(( term_cols - 68 > 10 ? term_cols - 68 : 12 ))
      cat_limit=1
      cat_max_len=$(( summary_budget - 8 > 6 ? summary_budget - 8 : 6 ))
    elif [[ $term_cols -le 115 ]]; then
      summary_budget=$(( term_cols - 72 ))
      cat_limit=2
      cat_max_len=$(( summary_budget / 2 - 8 > 8 ? summary_budget / 2 - 8 : 8 ))
    else
      summary_budget=$(( term_cols - 75 ))
      cat_limit=3
      cat_max_len=$(( summary_budget / 3 - 6 > 10 ? summary_budget / 3 - 6 : 10 ))
    fi

    queries=()
    while IFS=$'\t' read -r col type; do
      [[ -z $col ]] && continue
      col_esc=$(printf '%s' "${col//\'/\'\'}")
      col_id="\"$col_esc\""

      case "${type^^}" in
        TINYINT|SMALLINT|INTEGER|BIGINT|HUGEINT|UTINYINT|USMALLINT|UINTEGER|UBIGINT|UHUGEINT|FLOAT|DOUBLE|DECIMAL*|REAL|NUMERIC|INTERVAL)
          q="SELECT
  '$col_esc' AS \"column\",
  '$type' AS \"type\",
  count($col_id)::BIGINT AS non_null,
  (COALESCE(round(100.0 * (count(*) - count($col_id)) / NULLIF(count(*), 0), 1), 0.0) || '%')::VARCHAR AS null_pct,
  count(DISTINCT $col_id)::BIGINT AS approx_unique,
  CASE WHEN count($col_id) = 0 THEN '' ELSE
    COALESCE((SELECT tp_sparkline(list(cnt ORDER BY bin)) FROM (
       SELECT b.i AS bin, count(d.val)::DOUBLE AS cnt, max(count(d.val)::DOUBLE) OVER () AS max_c
       FROM range(10) b(i)
       LEFT JOIN (
         SELECT CASE WHEN max_v = min_v THEN 0 ELSE least(9, floor(10.0 * (val - min_v) / NULLIF(max_v - min_v, 0))::INT) END AS bin, val
         FROM (SELECT $col_id::DOUBLE AS val, min($col_id::DOUBLE) OVER () AS min_v, max($col_id::DOUBLE) OVER () AS max_v FROM __duckeye_src WHERE $col_id IS NOT NULL)
       ) d ON b.i = d.bin
       GROUP BY b.i
    )), '')::VARCHAR
  END AS distribution,
  CASE WHEN count($col_id) = 0 THEN 'all null' ELSE
    ('min: ' || COALESCE(min($col_id)::VARCHAR, 'NULL') || ', avg: ' || COALESCE(round(avg($col_id), 2)::VARCHAR, 'NULL') || ', max: ' || COALESCE(max($col_id)::VARCHAR, 'NULL'))::VARCHAR
  END AS summary
FROM __duckeye_src"
          ;;
        DATE|TIMESTAMP*|TIMESTAMPTZ)
          q="SELECT
  '$col_esc' AS \"column\",
  '$type' AS \"type\",
  count($col_id)::BIGINT AS non_null,
  (COALESCE(round(100.0 * (count(*) - count($col_id)) / NULLIF(count(*), 0), 1), 0.0) || '%')::VARCHAR AS null_pct,
  count(DISTINCT $col_id)::BIGINT AS approx_unique,
  CASE WHEN count($col_id) = 0 THEN '' ELSE
    COALESCE((SELECT tp_sparkline(list(cnt ORDER BY bin)) FROM (
       SELECT b.i AS bin, count(d.val)::DOUBLE AS cnt, max(count(d.val)::DOUBLE) OVER () AS max_c
       FROM range(10) b(i)
       LEFT JOIN (
         SELECT CASE WHEN max_e = min_e THEN 0 ELSE least(9, floor(10.0 * (val - min_e) / NULLIF(max_e - min_e, 0))::INT) END AS bin, val
         FROM (SELECT epoch($col_id::TIMESTAMP)::DOUBLE AS val, min(epoch($col_id::TIMESTAMP)) OVER () AS min_e, max(epoch($col_id::TIMESTAMP)) OVER () AS max_e FROM __duckeye_src WHERE $col_id IS NOT NULL)
       ) d ON b.i = d.bin
       GROUP BY b.i
    )), '')::VARCHAR
  END AS distribution,
  CASE WHEN count($col_id) = 0 THEN 'all null' ELSE
    ('min: ' || min($col_id)::VARCHAR || ', max: ' || max($col_id)::VARCHAR || COALESCE(' (' || (max($col_id::TIMESTAMP) - min($col_id::TIMESTAMP))::VARCHAR || ')', ''))::VARCHAR
  END AS summary
FROM __duckeye_src"
          ;;
        TIME*|TIMETZ)
          q="SELECT
  '$col_esc' AS \"column\",
  '$type' AS \"type\",
  count($col_id)::BIGINT AS non_null,
  (COALESCE(round(100.0 * (count(*) - count($col_id)) / NULLIF(count(*), 0), 1), 0.0) || '%')::VARCHAR AS null_pct,
  count(DISTINCT $col_id)::BIGINT AS approx_unique,
  CASE WHEN count($col_id) = 0 THEN '' ELSE
    COALESCE((SELECT tp_sparkline(list(cnt ORDER BY bin)) FROM (
       SELECT b.i AS bin, count(d.val)::DOUBLE AS cnt, max(count(d.val)::DOUBLE) OVER () AS max_c
       FROM range(10) b(i)
       LEFT JOIN (
         SELECT CASE WHEN max_e = min_e THEN 0 ELSE least(9, floor(10.0 * (val - min_e) / NULLIF(max_e - min_e, 0))::INT) END AS bin, val
         FROM (SELECT date_part('epoch', $col_id)::DOUBLE AS val, min(date_part('epoch', $col_id)) OVER () AS min_e, max(date_part('epoch', $col_id)) OVER () AS max_e FROM __duckeye_src WHERE $col_id IS NOT NULL)
       ) d ON b.i = d.bin
       GROUP BY b.i
    )), '')::VARCHAR
  END AS distribution,
  CASE WHEN count($col_id) = 0 THEN 'all null' ELSE
    ('min: ' || min($col_id)::VARCHAR || ', max: ' || max($col_id)::VARCHAR)::VARCHAR
  END AS summary
FROM __duckeye_src"
          ;;
        *\[\]|LIST*|*ARRAY*)
          q="SELECT
  '$col_esc' AS \"column\",
  '$type' AS \"type\",
  count($col_id)::BIGINT AS non_null,
  (COALESCE(round(100.0 * (count(*) - count($col_id)) / NULLIF(count(*), 0), 1), 0.0) || '%')::VARCHAR AS null_pct,
  count(DISTINCT $col_id)::BIGINT AS approx_unique,
  CASE WHEN count($col_id) = 0 THEN '' ELSE
    COALESCE((SELECT tp_sparkline(list(cnt ORDER BY bin)) FROM (
       SELECT b.i AS bin, count(d.val)::DOUBLE AS cnt, max(count(d.val)::DOUBLE) OVER () AS max_c
       FROM range(10) b(i)
       LEFT JOIN (
         SELECT CASE WHEN max_s = min_s THEN 0 ELSE least(9, floor(10.0 * (val - min_s) / NULLIF(max_s - min_s, 0))::INT) END AS bin, val
         FROM (SELECT len($col_id)::DOUBLE AS val, min(len($col_id)) OVER () AS min_s, max(len($col_id)) OVER () AS max_s FROM __duckeye_src WHERE $col_id IS NOT NULL)
       ) d ON b.i = d.bin
       GROUP BY b.i
    )), '')::VARCHAR
  END AS distribution,
  CASE WHEN count($col_id) = 0 THEN 'all null' ELSE
    ('len min: ' || COALESCE(min(len($col_id))::VARCHAR, '0') || ', avg: ' || COALESCE(round(avg(len($col_id)), 1)::VARCHAR, '0') || ', max: ' || COALESCE(max(len($col_id))::VARCHAR, '0') || ', e.g. ' || COALESCE(substr(any_value($col_id)::VARCHAR, 1, $summary_budget), ''))::VARCHAR
  END AS summary
FROM __duckeye_src"
          ;;
        BLOB)
          # A BLOB is bytes, so it profiles the way a list profiles: by size. The
          # catch-all branch below would histogram it as a category, and since
          # BLOB::VARCHAR escapes every non-printable byte, that yields a frequency
          # table over unreadable escape soup -- accurate and useless. octet_length,
          # not length: length() has no BLOB overload at all.
          #
          # The preview still goes through ::VARCHAR, which is what makes it useful
          # here rather than in the histogram -- one escaped sample tells you whether
          # the column holds text or binary; a hundred of them tell you nothing.
          q="SELECT
  '$col_esc' AS \"column\",
  '$type' AS \"type\",
  count($col_id)::BIGINT AS non_null,
  (COALESCE(round(100.0 * (count(*) - count($col_id)) / NULLIF(count(*), 0), 1), 0.0) || '%')::VARCHAR AS null_pct,
  count(DISTINCT $col_id)::BIGINT AS approx_unique,
  CASE WHEN count($col_id) = 0 THEN '' ELSE
    COALESCE((SELECT tp_sparkline(list(cnt ORDER BY bin)) FROM (
       SELECT b.i AS bin, count(d.val)::DOUBLE AS cnt, max(count(d.val)::DOUBLE) OVER () AS max_c
       FROM range(10) b(i)
       LEFT JOIN (
         SELECT CASE WHEN max_s = min_s THEN 0 ELSE least(9, floor(10.0 * (val - min_s) / NULLIF(max_s - min_s, 0))::INT) END AS bin, val
         FROM (SELECT octet_length($col_id)::DOUBLE AS val, min(octet_length($col_id)) OVER () AS min_s, max(octet_length($col_id)) OVER () AS max_s FROM __duckeye_src WHERE $col_id IS NOT NULL)
       ) d ON b.i = d.bin
       GROUP BY b.i
    )), '')::VARCHAR
  END AS distribution,
  CASE WHEN count($col_id) = 0 THEN 'all null' ELSE
    ('bytes min: ' || COALESCE(min(octet_length($col_id))::VARCHAR, '0') || ', avg: ' || COALESCE(round(avg(octet_length($col_id)), 1)::VARCHAR, '0') || ', max: ' || COALESCE(max(octet_length($col_id))::VARCHAR, '0') || ', e.g. ' || COALESCE(substr(any_value($col_id)::VARCHAR, 1, $summary_budget), ''))::VARCHAR
  END AS summary
FROM __duckeye_src"
          ;;
        MAP*)
          q="SELECT
  '$col_esc' AS \"column\",
  '$type' AS \"type\",
  count($col_id)::BIGINT AS non_null,
  (COALESCE(round(100.0 * (count(*) - count($col_id)) / NULLIF(count(*), 0), 1), 0.0) || '%')::VARCHAR AS null_pct,
  count(DISTINCT $col_id)::BIGINT AS approx_unique,
  CASE WHEN count($col_id) = 0 THEN '' ELSE
    COALESCE((SELECT tp_sparkline(list(cnt ORDER BY bin)) FROM (
       SELECT b.i AS bin, count(d.val)::DOUBLE AS cnt, max(count(d.val)::DOUBLE) OVER () AS max_c
       FROM range(10) b(i)
       LEFT JOIN (
         SELECT CASE WHEN max_s = min_s THEN 0 ELSE least(9, floor(10.0 * (val - min_s) / NULLIF(max_s - min_s, 0))::INT) END AS bin, val
         FROM (SELECT cardinality($col_id)::DOUBLE AS val, min(cardinality($col_id)) OVER () AS min_s, max(cardinality($col_id)) OVER () AS max_s FROM __duckeye_src WHERE $col_id IS NOT NULL)
       ) d ON b.i = d.bin
       GROUP BY b.i
    )), '')::VARCHAR
  END AS distribution,
  CASE WHEN count($col_id) = 0 THEN 'all null' ELSE
    ('entries min: ' || COALESCE(min(cardinality($col_id))::VARCHAR, '0') || ', max: ' || COALESCE(max(cardinality($col_id))::VARCHAR, '0') || ', e.g. ' || COALESCE(substr(any_value($col_id)::VARCHAR, 1, $summary_budget), ''))::VARCHAR
  END AS summary
FROM __duckeye_src"
          ;;
        STRUCT*|JSON)
          q="SELECT
  '$col_esc' AS \"column\",
  '$type' AS \"type\",
  count($col_id)::BIGINT AS non_null,
  (COALESCE(round(100.0 * (count(*) - count($col_id)) / NULLIF(count(*), 0), 1), 0.0) || '%')::VARCHAR AS null_pct,
  count(DISTINCT $col_id)::BIGINT AS approx_unique,
  ''::VARCHAR AS distribution,
  COALESCE(('e.g. ' || substr(any_value($col_id)::VARCHAR, 1, $summary_budget)), '')::VARCHAR AS summary
FROM __duckeye_src"
          ;;
        *)
          q="SELECT
  '$col_esc' AS \"column\",
  '$type' AS \"type\",
  count($col_id)::BIGINT AS non_null,
  (COALESCE(round(100.0 * (count(*) - count($col_id)) / NULLIF(count(*), 0), 1), 0.0) || '%')::VARCHAR AS null_pct,
  count(DISTINCT $col_id)::BIGINT AS approx_unique,
  ''::VARCHAR AS distribution,
  COALESCE((SELECT string_agg((CASE WHEN length(k) > $cat_max_len THEN substr(k, 1, $cat_max_len - 3) || '...' ELSE k END) || ' (' || round(100.0 * v / NULLIF((SELECT count(*) FROM __duckeye_src), 0), 1) || '%)', ', ' ORDER BY v DESC)
   FROM (
     SELECT unnest(map_keys(histogram($col_id::VARCHAR)))::VARCHAR AS k,
            unnest(map_values(histogram($col_id::VARCHAR))) AS v
     FROM __duckeye_src
     LIMIT $cat_limit
   )
  ), '')::VARCHAR AS summary
FROM __duckeye_src"
          ;;
      esac
      queries+=("$q")
    done <<< "$cols_raw"

    sql="CREATE VIEW __duckeye_src AS $target_query; "
    for i in "${!queries[@]}"; do
      [[ $i -gt 0 ]] && sql+=" UNION ALL "
      sql+="${queries[$i]}"
    done
    sql+=";"
  else
    sql="$target_query;"
  fi

  # Sparklines come from textplot's tp_sparkline(). Only -Z draws them, so -d and
  # -z do not pay for the load.
  [[ $mode == profile ]] && exts+=" textplot"
  # httpfs gets autoloaded, and its OpenSSL shutdown path segfaults at exit when
  # textplot is also loaded -- Query-farm/textplot#4, confirmed by the author. The
  # query completes and its output is byte-identical; only the exit status is
  # wrong, which is worse than a visible failure because a caller checking $? sees
  # a crash after receiving correct results.
  #
  # Data mode names every extension it needs, so autoload buys nothing here --
  # except for a remote source, where httpfs itself arrives that way. So: off for
  # local paths, left alone for remote ones, which is also the only case where
  # httpfs is genuinely wanted.
  case $f in
    http://*|https://*|s3://*) ;;
    *) no_autoload="SET autoload_known_extensions=false; " ;;
  esac
  load="${no_autoload:-}"
  for e in $exts $DUCKEYE_EXTS; do load+="LOAD $e; "; done
  # Piped output is read by programs, not people, so it leaves the box behind. JSONL
  # rather than CSV/TSV because duckeye's cells routinely hold document text: .mode tabs
  # emits an embedded tab or newline RAW, silently turning one row into extra columns or
  # extra lines, and CSV quotes it correctly but still spans physical lines so grep and
  # wc -l miscount. JSONL escapes both, stays one record per line, and renders
  # STRUCT/LIST/MAP as real JSON instead of DuckDB's display syntax.
  #
  # -Z is the exception: it is textplot ANSI histograms, and the picture IS the output.
  # As JSON it would be a table of bar-chart strings, so it keeps the box on every path.
  if want_color; then
    duck=(duckdb $(duckdb_color_mode) -cmd ".mode box" -cmd ".maxwidth $term_cols" -c "$load $sql")
  elif [[ $mode == profile ]]; then
    duck=(duckdb $(duckdb_color_mode) -cmd ".mode box" -cmd ".maxwidth 0" -c "$load $sql")
  else
    duck=(duckdb $(duckdb_color_mode) -cmd ".mode jsonlines" -c "$load $sql")
  fi
  page=(cat); [[ -n $do_page && -n $DUCKEYE_PAGER ]] && page=($DUCKEYE_PAGER)
  "${duck[@]}" | "${page[@]}"
  exit "${PIPESTATUS[0]}"
fi

## A .zim holds thousands of articles, so the verbs address the corpus rather than
# one document: -T indexes it, -s runs the archive's own Xapian full-text search,
# -S opens an article. Reaching *into* an article is what the zim:// form below is
# for, and there the ordinary document verbs apply unchanged.
if [[ $key == *.zim ]]; then
  if [[ $mode == section ]]; then
    # zim_suggest walks the title index, so this stays fast on a full Wikipedia.
    # zim_get_text pulls the article's bytes straight through, no filesystem hop.
    exts="webbed markdown zim pdf"
    premacro+=$zim_macro
    doc="SELECT zim_to_blocks('$src', s.path) AS blocks
         FROM (SELECT path FROM zim_suggest('$src', '$pat', max_results := 1)) s"
    mode=full zim_open=1        # an opened article renders whole
  else
    # The corpus verbs print tables of archive metadata, not documents, so there are no
    # blocks for a serializer to act on. -S drops through to the branch above, where it
    # opens an article and -t applies normally.
    [[ $out_fmt == ansi ]] ||
      die "-t applies to documents; for an archive it only makes sense with -S" 64
    case $mode in
      full)   zsql="SELECT UNNEST(zim_info('$src'));" ;;
      # OFFSET 0 blocks filter pushdown: read_zim silently ignores a pushed-down
      # mimetype predicate and returns every row (teaguesterling/duckdb_zim#29).
      toc)    zsql="SELECT path, title FROM (SELECT * FROM read_zim('$src') OFFSET 0)
                    WHERE NOT is_redirect AND mimetype LIKE 'text/html%'
                    ${limit:+LIMIT $limit};" ;;
      search) zsql="SELECT round(score, 1) AS score, title, path,
                           regexp_replace(coalesce(snippet, ''), '<[^>]*>', '', 'g') AS snippet
                    FROM zim_search('$src', '$pat', max_results := ${limit:-25})
                    ORDER BY score DESC;" ;;
    esac
    term_cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 120)}
    [[ $term_cols =~ ^[0-9]+$ && $term_cols -gt 0 ]] || term_cols=120
    load="LOAD zim; "
    for e in $DUCKEYE_EXTS; do load+="LOAD $e; "; done
    page=(cat); [[ -n $do_page && -n $DUCKEYE_PAGER ]] && page=($DUCKEYE_PAGER)
    # Same rule as the data modes: a pipe gets JSONL, a terminal or pager gets the box.
    if want_color; then
      duckdb $(duckdb_color_mode) -cmd ".mode box" -cmd ".maxwidth $term_cols" -s "$load" -s "$zsql" | "${page[@]}"
    else
      duckdb $(duckdb_color_mode) -cmd ".mode jsonlines" -s "$load" -s "$zsql" | "${page[@]}"
    fi
    exit "${PIPESTATUS[0]}"
  fi
fi


[[ -n $doc ]] ||                   # already resolved above (an opened zim article)
case "$key" in                     # NB: patterns unquoted, or globbing is disabled
  zim://*)                         # zim://<archive>.zim/<entry> names one entry
    rest=${f#zim://}
    [[ $rest == *.zim/* ]] || die "zim:// needs an entry path: zim://ARCHIVE.zim/ENTRY" 64
    exts="webbed markdown zim pdf"
    premacro+=$zim_macro
    doc="SELECT zim_to_blocks('$(q "${rest%%.zim/*}.zim")', '$(q "${rest#*.zim/}")') AS blocks" ;;
  *.md|*.markdown)
    exts="markdown"
    doc="SELECT list(b) AS blocks FROM read_markdown_blocks('$src') b" ;;
  *.htm|*.html)
    exts="webbed"
    doc="SELECT list(b) AS blocks FROM read_html_blocks('$src') b" ;;
  *.pdf)
    exts="markdown pdf"
    # Both paths go through read_pdf, which is the only reader that knows where the
    # pages are. Each page contributes a page_break marker carrying its number,
    # then that page's prose.
    #
    # This used to synthesise '## Page N' as a MARKDOWN HEADING, which put physical
    # pagination into the semantic outline: -t listed "Page 1, Page 2" as though an
    # author had written them, and -S would happily slice on one. page_break is a
    # marker, the way hr is a rule -- pages are now their own axis, reachable with
    # duck_blocks_page_rows / duck_blocks_get_pages, and absent from the heading
    # outline where they never belonged. It also answers a question a heading
    # cannot: which page a boundary ENDS, since the next marker bounds the previous
    # page.
    #
    # -P still pushes down into read_pdf rather than slicing afterwards: a page
    # range is knowable from the path, so reading 2 pages of 400 beats reading 400
    # and discarding 398. duck_blocks_get_pages is the surface for a document
    # already in hand, which is a different job.
    # SERIAL, and this is a correctness fix rather than a tuning knob. Each page is
    # parsed separately -- that is what makes pages addressable -- so read_pdf's
    # parallel scan calls cmark once per page concurrently, and cmark's global flag
    # registration is not thread-safe: duckdb aborts with "flag initialization error
    # in cmark_register_node_flag". The rate scales with page count, which is why a
    # 2-page fixture almost never showed it:
    #
    #     2-page PDF    1-2 aborts per 150-300 runs
    #     60-page PDF   3 aborts per 5 runs
    #
    # A single warmup parse does not fix it (1/300, no better than baseline), so the
    # race is not only in first-use registration.
    #
    # Serial is also FASTER here, by 4-5x on 60 pages: sixty small parses cost more
    # to coordinate than to run. Non-PDF paths are untouched and unaffected.
    prethreads="SET threads=1; "
    p_args=
    [[ -n $p_first ]] && p_args+="first_page := $p_first"
    [[ -n $p_last ]] && p_args+="${p_args:+, }last_page := $p_last"
    # Pages are joined with duck_blocks_merge, folded over the per-page lists.
    #
    # The two neighbouring functions have opposite contracts and it matters here:
    # duck_blocks_reorder TRUSTS element_order and repairs the list, while
    # duck_blocks_merge TRUSTS the list and repairs element_order. Each page's
    # parse restarts numbering at 0, so the orders are known-wrong and only merge's
    # contract applies -- reorder would sort on the colliding keys and group every
    # page marker ahead of every paragraph. duck_blocks_concat is the raw append
    # and does not touch order at all.
    # The page_break attributes map must never be empty: an untyped MAP{} infers
    # MAP("NULL","NULL") rather than MAP(VARCHAR,VARCHAR), and the ::duck_block cast
    # would then fail on every page. Non-emptiness is what makes the inference right
    # -- there is no cast on the map itself, only on the struct around it.
    doc="WITH __pg AS (
           SELECT page, list_prepend(
                    {'kind':'block','element_type':'page_break','content':NULL,'level':NULL,
                     'encoding':'text','attributes':MAP{'page_number': page::VARCHAR},
                     'element_order':0}::duck_block,
                    parse_markdown_to_duck_blocks(coalesce(text, ''))) AS pb
           FROM read_pdf('$src'${p_args:+, $p_args}))
         SELECT reduce(list(pb ORDER BY page),
                       lambda acc, x: duck_blocks_merge(acc, x)) AS blocks
         FROM __pg" ;;
  *.json|.pandoc_ast)              # Pandoc AST
    doc="SELECT read_pandoc_ast('$src') AS blocks" ;;
  *.py|*.pyi|*.pyw|*.rs|*.go|*.c|*.h|*.cpp|*.hpp|*.cc|*.cxx|*.c++|*.hh|*.hxx|\
  *.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.java|*.kt|*.kts|*.cs|*.swift|*.rb|*.ruby|\
  *.php|*.php3|*.php4|*.php5|*.phtml|*.lua|*.r|*.sh|*.bash|*.zsh|*.zig|*.dart|\
  *.sql|*.gql|*.graphql|*.tf|*.tfvars|*.hcl|*.css|.auto)
    exts="sitting_duck"
    code_src=1     # this reader applies -Q itself; see the -Q block's guard
    if [[ -n ${selector:-} ]]; then
      premacro+="CREATE OR REPLACE TEMP TABLE __ast AS SELECT * FROM read_ast('$src', peek := 'full');
CREATE OR REPLACE TEMP TABLE __sel AS SELECT * FROM ast_select_from('__ast', '$(q "$selector")'); "
      doc="SELECT list(block) AS blocks FROM ast_to_blocks_from('__sel')"
    else
      doc="SELECT flatten(list(blocks)) AS blocks FROM ast_to_blocks_list('$src')"
    fi ;;
  *.docx|*.odt|*.epub|*.org|*.tex|*.rtf|*.textile|*.mediawiki)
    # panduck reads all ten natively: no pandoc(1) process, no AST round-trip through
    # a pipe, and no dependency on duck_block_utils' deprecated pandoc_ast_to_blocks.
    # The readers return duck_block rows directly, so they compose with the same
    # pipeline every other format uses.
    exts="panduck"
    case "$key" in
      *.docx)      doc="SELECT list(b) AS blocks FROM read_docx_blocks('$src') b" ;;
      *.odt)       doc="SELECT list(b) AS blocks FROM read_odt_blocks('$src') b" ;;
      *.epub)      doc="SELECT list(b) AS blocks FROM read_epub_blocks('$src') b" ;;
      *.org)       doc="SELECT list(b) AS blocks FROM read_org_blocks('$src') b" ;;
      *.tex)       doc="SELECT list(b) AS blocks FROM read_latex_blocks('$src') b" ;;
      *.rtf)       doc="SELECT list(b) AS blocks FROM read_rtf_blocks('$src') b" ;;
      *.textile)   doc="SELECT list(b) AS blocks FROM read_textile_blocks('$src') b" ;;
      *.mediawiki) doc="SELECT list(b) AS blocks FROM read_mediawiki_blocks('$src') b" ;;
    esac ;;
  *.rst|*.ipynb|*.man|*.[1-9])
    # Three formats stay on pandoc(1), each for a measured reason:
    #
    #   .ipynb  panduck's reader emits a markdown cell as ONE raw block holding the
    #           cell source verbatim, so no headings are extracted: -T finds nothing
    #           and -S finds no sections. pandoc parses cell markdown into blocks.
    #   .rst    panduck's reader keeps literal inline markup inside table cells --
    #           a **plum** cell renders as **plum** rather than emphasised text.
    #   .man    panduck_can_read('a.man') is false and no extension in the stack
    #           reads roff, so pandoc is the only route. WHY panduck does not read
    #           it is NOT RECORDED -- an earlier version of this comment asserted
    #           panduck had declined roff deliberately, which panduck checked and
    #           denied: no mention of roff, troff, groff or man pages exists in its
    #           README, docs, src or FOLLOWUPS, while its other deliberate declines
    #           ARE written down. That attribution was invented here. State the
    #           measurement, not a motive nobody has claimed.
    command -v pandoc >/dev/null ||
      die "${key##*.} needs pandoc, which is not installed" 3
    # Name the reader rather than letting pandoc infer it: .man, and the numbered
    # sections, defeat inference.
    case "$key" in
      *.rst)         from=rst ;;
      *.ipynb)       from=ipynb ;;
      *.man|*.[1-9]) from=man ;;
    esac
    via_pandoc=1
    # read_pandoc_ast() silently returns [] on a pipe (constant-folded double-read,
    # teaguesterling/duckdb_duck_block_utils#18), so stdin goes via read_text().
    # panduck's reader, not duck_block_utils' pandoc_ast_to_blocks, which is
    # deprecated and printed a notice to stderr on every .rst/.ipynb/.man render.
    # Same blocks out, measured; one less thing duckeye owns.
    exts+=" panduck"
    doc="SELECT list(b) AS blocks FROM read_pandoc_blocks('/dev/stdin') b" ;;
  http*://*)
    # Assume http(s):// with no extension is HTML
    exts="webbed"
    doc="SELECT list(b) AS blocks FROM read_html_blocks('$src') b" ;;
  *)
    die "unsupported extension: ${f##*/}" 2 ;;
esac


if [[ $f == http://* || $f == https://* ]]; then
  exts="$exts http"
elif [[ $f == s3://* ]]; then
  exts="$exts aws http"
elif [[ $f == git://* ]]; then
  exts="$exts duck_tails"
fi

# MATERIALIZED: the section/search queries reference the document more than once,
# and the pandoc path's source is stdin, which can only be read one time.
# HTML aliases for duck_block types. A preprocessor over the selector, applied
# before it reaches the css parse, so `-Q 'h2'` and `-Q 'li'` work for anyone who
# knows HTML but not the duck_block vocabulary. h1..h6 rewrite to an ATTRIBUTE on
# the selected node, which is exactly the case the post-filter handles correctly.
#
# Word-boundary substitution rather than a parse rewrite: rebuilding a selector from
# its parse tree is more machinery than this earns, and the boundaries hold for
# every shape duck_block selectors take. It would mis-fire on a tag name appearing
# inside a quoted attribute VALUE (-Q 'a[href="li"]'), which is why the aliases run
# only over the portion outside brackets.
css_alias() {
  local sel=$1 head tail
  # split at the first '[' so attribute values are never rewritten
  if [[ $sel == *\[* ]]; then head=${sel%%\[*}; tail=${sel:${#head}}; else head=$sel; tail=; fi
  head=$(printf '%s' "$head" | sed -E '
    s/\bh([1-6])\b/heading[heading_level=\1]/g
    s/\bp\b/paragraph/g
    s/\b(ul|ol)\b/list/g
    s/\bli\b/list_item/g
    s/\ba\b/link/g
    s/\b(strong|b)\b/bold/g
    s/\b(em|i)\b/italic/g
    s/\bpre\b/code/g
    s/\bimg\b/image/g
    s/\bbr\b/line_break/g
    s/\bdel\b/strikethrough/g')
  printf '%s%s' "$head" "$tail"
}

# ---------------------------------------------------------------- -Q on documents
# -Q queries source code by CSS selector through sitting_duck. Documents can be
# queried the same way, because duck_blocks are the same SHAPE as an AST: a
# depth-first ordering plus a level column fully determines a tree, so node_id is
# row position and a node's parent is the nearest preceding row at a smaller level.
# Projecting that into sitting_duck's node schema lets ast_select_from run
# unchanged -- one selector language over code and prose, rather than a second
# dialect to keep in sync. prototypes/leveled_ast.sql has the generic form, and
# teaguesterling/sitting_duck#117 asks for the two changes that remove the
# workarounds below.
# -S/-s compute a SPAN over document order; -Q selects nodes from a tree. To compose
# them the span has to come FIRST -- narrow the document, then select inside it --
# which is why these produce a DOCUMENT-PRODUCING EXPRESSION rather than a finished
# query. On their own the result is serialised straight out; with -Q it becomes the
# document the selector runs against. Before this, -Q rewrote the document first and
# -S then searched the selector's leftovers for a heading, which is why `-S Install
# -Q code` reported "no section matching 'Install'" while plain `-S Install` worked.
section_span_doc() {
  printf '%s\n' "WITH doc AS MATERIALIZED ($1),
     h AS (SELECT e.level AS lvl, e.title AS title, e.id AS id, e.element_order AS ord
           FROM (SELECT unnest(duck_blocks_headings_structs(blocks)) AS e FROM doc)),
     sec AS (SELECT h1.ord AS s, coalesce(min(h2.ord) - 1, 2147483647) AS e
             FROM h h1 LEFT JOIN h h2 ON h2.ord > h1.ord AND h2.lvl <= h1.lvl
             WHERE h1.title ILIKE '%$pat%' ESCAPE '\\' OR h1.id = '$pat'
             GROUP BY h1.ord),
     -- A substring can match both a chapter and a section inside it. The chapter
     -- already carries the child, so keeping both printed it twice; drop any span
     -- another span contains.
     top AS (SELECT s, e FROM sec a
             WHERE NOT EXISTS (SELECT 1 FROM sec b
                               WHERE b.s <= a.s AND b.e >= a.e AND (b.s, b.e) <> (a.s, a.e)))
     SELECT duck_blocks_reorder(flatten(list(duck_blocks_slice(doc.blocks, top.s, top.e)
                                             ORDER BY top.s))) AS blocks
     FROM doc, top HAVING count(*) > 0"
}

# Spans here stop at the next heading of *any* level, so a hit reports the innermost
# section that holds it rather than nesting parent inside child.
search_span_doc() {
  printf '%s\n' "WITH doc AS MATERIALIZED ($1),
     h AS (SELECT e.element_order AS ord
           FROM (SELECT unnest(duck_blocks_headings_structs(blocks)) AS e FROM doc)),
     span AS (SELECT ord AS s, coalesce(lead(ord) OVER (ORDER BY ord) - 1, 2147483647) AS e
              FROM h
              UNION ALL   -- anything ahead of the first heading, and whole
                          -- documents that have no headings at all
              SELECT 0 AS s, e FROM (SELECT coalesce((SELECT min(ord) - 1 FROM h),
                                                     2147483647)::INTEGER AS e)
              WHERE e >= 0),
     hit AS (SELECT s, e FROM doc, span
             WHERE duck_blocks_to_match_text(duck_blocks_slice(doc.blocks, span.s, span.e))
                   ILIKE '%$pat%' ESCAPE '\\')
     SELECT duck_blocks_reorder(flatten(list(duck_blocks_slice(doc.blocks, hit.s, hit.e)
                                             ORDER BY hit.s))) AS blocks
     FROM doc, hit HAVING count(*) > 0"
}

# Narrow BEFORE selecting. mode is left alone: it still names what the user asked for,
# which is what the empty-result messages below report against.
span_probe=
case $mode in
  section) doc=$(section_span_doc "$doc") ;;
  search)  doc=$(search_span_doc "$doc") ;;
esac
# Keep the span on its own, before -Q rewrites $doc again. An empty composed result
# has two causes -- the phrase found no section, or the section held nothing matching
# the selector -- and the finished query cannot tell them apart. This asks the span
# alone, but ONLY when the result came back empty, so a successful run never pays for
# it. Saying "either A or B" was honest; saying which one is useful.
[[ -n ${selector:-} && $mode != full ]] &&
  span_probe="SELECT count(*) FROM ($doc) WHERE blocks IS NOT NULL;"

#
# Until now, -Q on a document was SILENTLY IGNORED: the selector was accepted and
# the whole file rendered as though it had never been given.
# Code sources already honour -Q: they route through sitting_duck's own
# ast_select/ast_select_from before ever building blocks, so $doc for them is
# ALREADY the selected subset. Re-projecting it here would apply the document
# pipeline to an AST-derived block list and select from the wrong tree -- measured,
# it broke `-Q` on .py and on code globs while document selectors worked.
# The test is an explicit flag, not a substring of $doc. It used to be `$doc !=
# *ast_to_blocks*`, which was meant to spot sitting_duck's ast_to_blocks_from -- but
# duck_block_utils' pandoc_ast_to_blocks CONTAINS that substring, so every
# pandoc-routed format (.rst, .ipynb, .man) matched the exclusion and had its -Q
# silently ignored. Measured: `-Q code -t text doc.rst` rendered the whole document.
# Silent ignore is the exact failure this block was added to end.
if [[ -n ${selector:-} && -n $doc && -z ${code_src:-}
      && $mode != raw && $mode != summary && $mode != profile ]]; then
  # An attribute on a CONTEXT node cannot work here. Attributes are matched after
  # the structural selector, so a condition on any node but the selected one is
  # lost -- `heading[heading_level=2] ~ code` would quietly return nothing. Refuse
  # rather than answer wrongly; sitting_duck#117 ask 1 is the real fix.
  aliased=$(css_alias "$selector")
  if [[ $aliased =~ \[[^]]*\][^[]*[\>\+\~[:space:]] ]]; then
    die "-Q: an attribute on a context node is not supported for documents yet ($selector).
       Put the attribute on the selected node, or see teaguesterling/sitting_duck#117" 64
  fi
  exts+=" sitting_duck"
  # SEMANTIC_TYPE is not in duckdb_types(), so typed NULLs must be borrowed from a
  # zero-row read_ast() of a real source file. duckeye itself is one, and is always
  # present. sitting_duck#117 ask 2 would remove this.
  qself=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
  qsel=$(q "$(css_alias "$selector")")
  premacro+="CREATE OR REPLACE TEMP TABLE __qb AS
      SELECT row_number() OVER () AS ord, b.level AS lvl, b.element_type AS ty,
             b.kind AS knd,
             coalesce(b.content,'') AS nm, b.attributes AS atr, b AS blk
      FROM (SELECT unnest(blocks) AS b FROM ($doc));
    CREATE OR REPLACE TEMP TABLE __qn AS
      SELECT 1 AS node_id, 0 AS ord, (SELECT min(lvl) FROM __qb) - 1 AS lvl, 'document' AS ty, '' AS nm
      UNION ALL SELECT ord + 1, ord, lvl, ty, nm FROM __qb;
    CREATE OR REPLACE TEMP TABLE __qa AS
      SELECT a.node_id::BIGINT AS node_id, a.ty::VARCHAR AS type,
             (SELECT semantic_type FROM read_ast('$qself') WHERE false) AS semantic_type,
             0::UTINYINT AS flags, a.nm::VARCHAR AS name,
             (SELECT qualified_name FROM read_ast('$qself') WHERE false) AS qualified_name,
             NULL::VARCHAR AS signature_type,
             (SELECT parameters FROM read_ast('$qself') WHERE false) AS parameters,
             NULL::VARCHAR[] AS modifiers, NULL::VARCHAR AS annotations,
             '$src'::VARCHAR AS file_path, 'duck_block' AS language,
             NULL::UINTEGER AS start_line, NULL::UINTEGER AS end_line,
             (SELECT max(p.node_id) FROM __qn p WHERE p.ord < a.ord AND p.lvl < a.lvl)::BIGINT AS parent_id,
             a.lvl::UINTEGER AS depth,
             (row_number() OVER (PARTITION BY (SELECT max(p.node_id) FROM __qn p
                WHERE p.ord < a.ord AND p.lvl < a.lvl) ORDER BY a.ord) - 1)::INTEGER AS sibling_index,
             (SELECT count(*) FROM __qn c WHERE c.ord > a.ord AND c.lvl = a.lvl + 1
                AND c.ord < coalesce((SELECT min(e.ord) FROM __qn e
                     WHERE e.ord > a.ord AND e.lvl <= a.lvl), 2147483647))::UINTEGER AS children_count,
             (SELECT count(*) FROM __qn d WHERE d.ord > a.ord
                AND d.ord < coalesce((SELECT min(e.ord) FROM __qn e
                     WHERE e.ord > a.ord AND e.lvl <= a.lvl), 2147483647))::UINTEGER AS descendant_count,
             (SELECT scope FROM read_ast('$qself') WHERE false) AS scope,
             a.nm::VARCHAR AS peek
      FROM __qn a;
    CREATE OR REPLACE TEMP TABLE __qat AS
      SELECT ord + 1 AS node_id, unnest(map_keys(atr)) AS key, unnest(map_values(atr)) AS value
      FROM __qb WHERE atr IS NOT NULL AND len(map_keys(atr)) > 0;
    CREATE OR REPLACE TEMP TABLE __qc AS
      SELECT an.name AS key,
             (SELECT trim(v.name, '\"') FROM parse_ast_list_table('$qsel','css') v
               WHERE v.parent_id = an.parent_id
                 AND v.type IN ('integer_value','plain_value','string_value') LIMIT 1) AS value
      FROM parse_ast_list_table('$qsel','css') an WHERE an.type = 'attribute_name';
    CREATE OR REPLACE TEMP TABLE __qs AS
      SELECT b.node_id FROM ast_select_from('__qa',
               regexp_replace('$qsel', '\[[^\]]*\]', '', 'g')) b
      WHERE NOT EXISTS (SELECT 1 FROM __qc c WHERE NOT EXISTS (
              SELECT 1 FROM __qat a WHERE a.node_id = b.node_id AND a.key = c.key
                AND (c.value IS NULL OR a.value = c.value)));
    "
  # A match carries its SUBTREE, not just the matched node. Container blocks hold no
  # text of their own -- a list_item's words live in child paragraphs, a paragraph's
  # in inline children -- so returning bare matches renders empty. Measured: `-Q
  # list_item` matched both items and printed nothing until the span was included.
  #
  # A block-kind match ALSO carries its ANCESTOR chain, because a child block is not
  # well-formed outside its container and the writers differ on how badly they take
  # it. Measured on a .docx, where the reader puts the item text on the list_item
  # itself rather than in a child paragraph: `-Q li` selected both items, yet
  # duck_blocks_to_pandoc_ast returned "blocks":[] -- a list_item with no enclosing
  # list is not representable in the Pandoc AST, so the text was DROPPED, and -t md
  # printed nothing. Pulling the real ancestors (rather than synthesising a wrapper)
  # keeps the container's own attributes -- bullet vs ordered, start number.
  #
  # kind='inline' matches are deliberately excluded: an inline's ancestor is the
  # paragraph holding it, and returning that would answer `-Q strong` with the whole
  # surrounding sentence. Those keep failing with the message that explains why.
  doc="SELECT list(k.blk ORDER BY k.ord) AS blocks FROM __qb k
       WHERE EXISTS (
         SELECT 1 FROM __qs s JOIN __qn n ON n.node_id = s.node_id
         WHERE k.ord >= n.ord
           AND k.ord < coalesce((SELECT min(e.ord) FROM __qn e
                 WHERE e.ord > n.ord AND e.lvl <= n.lvl), 2147483647))
          OR EXISTS (
         SELECT 1 FROM __qs s JOIN __qn n ON n.node_id = s.node_id
         JOIN __qb m ON m.ord = n.ord
         WHERE m.knd = 'block' AND k.ord < n.ord AND k.lvl < n.lvl
           AND n.ord < coalesce((SELECT min(e.ord) FROM __qn e
                 WHERE e.ord > k.ord AND e.lvl <= k.lvl), 2147483647))"
fi

cte="WITH doc AS MATERIALIZED ($doc)"

# A section runs to the block before the next heading. INT_MAX stands in for
# "to the end of the document" — db_blocks_slice takes an inclusive order range,
# and inline children share the block's order span, so they slice along with it.
case $mode in
  full|section|search)
    # section and search share this: their span SQL already ran, above, as part of
    # building $doc. One emit path for all three is the point of that refactor.
    # WHERE blocks IS NOT NULL, because an aggregate with no GROUP BY still returns
    # one row when nothing matched, and list() over zero rows is SQL NULL. Measured:
    # `-Q nosuchtype` printed the four characters NULL on stdout and exited 0 -- on
    # documents AND on source code -- while -t md and -t html got the error right,
    # because their extra conversion step turned that row into genuinely empty
    # output and tripped the guard below. Dropping the row makes every writer agree.
    sql="$cte SELECT $(emit 'blocks') FROM doc WHERE blocks IS NOT NULL;" ;;
  toc)
    # duck_blocks_toc_rows, not duck_blocks_toc. Both return the same five columns
    # today, but toc_rows is the row-shaped accessor BY RULING -- a table of contents
    # is an index, not an extract, so it stays metadata-only -- while duck_blocks_toc
    # is slated to return blocks. When that lands, `e.indent` and `e.title` stop
    # existing and this fails to BIND, which is the loud failure and still a failure.
    #
    # It is a table MACRO, so it takes a column. That distinction is the whole reason
    # this migration is possible: a table FUNCTION rejects `doc.blocks` outright, which
    # is how parse_html_blocks silently broke -S on ZIM archives for weeks.
    sql="$cte, t AS (SELECT r.* FROM doc, duck_blocks_toc_rows(doc.blocks) r)
         SELECT string_agg(repeat('  ', t.indent) || t.title, chr(10) ORDER BY t.element_order)
         FROM t HAVING count(*) > 0;" ;;
esac

[[ $out_fmt == html ]] && exts+=" webbed"     # duck_blocks_to_html lives there
[[ $out_fmt == md   ]] && exts+=" markdown"   # duck_blocks_to_md lives there
if [[ $out_fmt == pandoc ]]; then
  exts+=" panduck"
  # panduck's builder reports the api version it actually emits, so duckeye no longer
  # runs `pandoc -t json` just to read a version number out of the output. The casts
  # remain because the struct carries meta and blocks as JSON STRINGS.
  #
  # THIS WHOLE MACRO IS REPLACEABLE, gated on the artifact rather than on a version
  # number: panduck v0.4.1 added
  #
  #     panduck_pandoc_ast_json(duck_block[]) -> VARCHAR
  #
  # which passes the acceptance test (duckdb -list of it, piped to `pandoc -f json`,
  # exits 0). Do not trust the name -- despite "ast" it takes BLOCKS, while its
  # sibling panduck_pandoc_ast_to_blocks really does take an AST, so the pair implies
  # a symmetry that does not exist. That naming is why this was written by hand.
  # Replace the macro body with a call to it once
  #     SELECT count(*) FROM duckdb_functions() WHERE function_name='panduck_pandoc_ast_json'
  # returns 1 against the INSTALLED extension; the community registry still served
  # a57402b, which lacks it, when this was written.
  premacro+="CREATE OR REPLACE TEMP MACRO db_to_pandoc_json(b) AS (
    json_object('pandoc-api-version', panduck_blocks_to_pandoc_ast(b)['pandoc-api-version']::JSON,
                'meta',   panduck_blocks_to_pandoc_ast(b)['meta']::JSON,
                'blocks', panduck_blocks_to_pandoc_ast(b)['blocks']::JSON)); "
fi

load="${prethreads:-}"
for e in $DUCKEYE_BASE $exts $DUCKEYE_EXTS; do load+="LOAD $e; "; done

duck=(duckdb $(duckdb_color_mode) -list -noheader -s "$load")
[[ -n $premacro ]] && duck+=(-s "$premacro")   # its own -s: macros must exist before $sql binds
duck+=(-s "$sql")

# Runs $span_probe through the same reader the real query used -- a pandoc-routed
# file has to be piped in again, since its blocks arrive on stdin, not from a path.
# Only ever called on the failure path.
span_rows() {
  local q=(duckdb -list -noheader -s "$load" -s "$span_probe")
  if [[ -n $via_pandoc ]]; then
    pandoc -f "$from" "$f" -t json 2>/dev/null | "${q[@]}" 2>/dev/null
  else
    "${q[@]}" 2>/dev/null
  fi
}
page=(cat); [[ -n $do_page && -n $DUCKEYE_PAGER ]] && page=($DUCKEYE_PAGER)

# Buffered so an empty result can be reported instead of printed as silence.
out=$tmp/out

if [[ -n $via_pandoc ]]; then
  pandoc -f "$from" "$f" -t json | "${duck[@]}" >"$out"
  st=("${PIPESTATUS[@]}")
  (( st[0] )) && die "pandoc failed on $f" "${st[0]}"
  (( st[1] )) && exit "${st[1]}"
else
  "${duck[@]}" >"$out" || exit $?
fi

# duckdb prints a blank line for a single NULL row, so test for real content.
if ! grep -q '[^[:space:]]' "$out"; then
  case $mode in
    toc)     die "no headings in $f" ;;
    section|search)
             # Composed, these run span-then-select. Re-run the span by itself to say
             # WHICH half came up empty rather than listing both possibilities.
             if [[ -n $span_probe ]]; then
               [[ $(span_rows) == 0 ]] && die "no section matching '$arg' in $f"
               die "no blocks matching '$selector' inside '$arg' in $f
       The section is there; nothing in it matched the selector. Drop -Q to see
       the section, or widen the selector."
             fi
             die "no section matching '$arg' in $f" ;;
    full)    [[ -n $zim_open ]] && die "no article matching '$arg' in $f"
             # -Q produced nothing. Two causes, and the second is not obvious:
             # either no block matched, or the matches were INLINE types (bold,
             # italic, text, link) which duck_blocks_render_ansi does not render
             # standalone -- an inline is drawn as part of its containing block, so
             # a list of only inlines renders empty. Measured: `-Q bold` selects the
             # node and prints nothing. Exiting 0 with empty output hid both.
             # Do not claim "nothing matched" -- at this point only the OUTPUT is
             # known to be empty, and there are two other causes. Measured:
             # `-Q li` on a .docx prints the items, `-Q li -t blocks` shows them in
             # the JSON, and `-Q li -t md` produces nothing, because a bare
             # list_item is not valid Pandoc AST outside its list. Saying "no blocks
             # matching" there is simply false.
             [[ -n ${selector:-} ]] &&
               die "no output for '$selector' in $f
       Either nothing matched, or every match was an inline type (bold, italic,
       text, link), which renders only inside its containing block. Block-kind
       matches carry their container, so -Q li works; -Q strong cannot, because
       its container is the whole surrounding paragraph -- select that instead." ;;
  esac
fi

# The block renderer always emits SGR, so stripping here is what makes the escapes
# conditional. Only SGR (m) sequences go, leaving the layout the renderer computed.
# -o FILE bypasses the pager and the colour decision entirely: a file is not a
# terminal, so escapes are stripped regardless of what want_color says about stdout.
if [[ -n $out_file ]]; then
  sed 's/\x1b\[[0-9;]*m//g' "$out" > "$out_file" || die "cannot write $out_file" 1
elif want_color; then
  "${page[@]}" <"$out"
else
  sed 's/\x1b\[[0-9;]*m//g' "$out" | "${page[@]}"
fi
